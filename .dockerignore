# Version control
.git/
.gitignore
.dockerignore

# Environment files (never bake secrets into the image)
.env
.env.*

# Virtual environments
.venv/
.venv-1/
venv/
env/

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Test artifacts / caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
tests/

# Ad-hoc verification/log files left in the repo root
*.log
*.tmp
*.temp
pytest_verification.log
pytest_verification.txt
suite_exit.txt
suite_result.txt
suite_result_utf8.txt
verification.txt
test_output.txt

# IDE / editor metadata
.vscode/
.idea/

# OS metadata
.DS_Store
Thumbs.db

# Local upload storage (not used to build the image)
uploads/

# Development-only docs, not required at runtime
plan.md
README.md
.env.example
